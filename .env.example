# Örnek ortam değişkenleri. Gerçek değerleri .env dosyasına yaz.
# Render "Internal Database URL" (uygulama Render'da çalışırken kullanılır)
DATABASE_URL=postgresql://KULLANICI:SIFRE@HOST/DATABASE
# Render "External Database URL" (yalnızca yerelden test için; SSL otomatik açılır)
EXTERNAL_DATABASE_URL=postgresql://KULLANICI:SIFRE@HOST.oregon-postgres.render.com/DATABASE
SECRET=degistir-bunu-rastgele-bir-anahtarla
PORT=3000
