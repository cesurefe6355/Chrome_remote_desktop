# Örnek ortam değişkenleri. Gerçek değerleri .env dosyasına yaz.
# Render "Internal Database URL" (uygulama Render'da çalışırken kullanılır)
DATABASE_URL=postgresql://KULLANICI:SIFRE@HOST/DATABASE
# Render "External Database URL" (yalnızca yerelden test için; SSL otomatik açılır)
EXTERNAL_DATABASE_URL=postgresql://KULLANICI:SIFRE@HOST.oregon-postgres.render.com/DATABASE

# Oturum imzalama anahtarı (en az 32 rastgele karakter). Örn: openssl rand -hex 32
# Tanımlanmazsa sunucu her açılışta rastgele bir anahtar üretir (oturumlar sıfırlanır).
# SECRET=buraya-rastgele-bir-anahtar-yaz

PORT=3000

# Yönetici paneli (/muhtar) şifresi (en az 12 karakter önerilir).
# Yorum satırında bırakılırsa panel TAMAMEN DEVRE DIŞI kalır (güvenli varsayılan).
# ADMIN_PASSWORD=buraya-guclu-bir-sifre-yaz

# İsteğe bağlı: güvenlik bildirimleri için iletişim adresi (security.txt)
# SECURITY_CONTACT=mailto:guvenlik@ornek.com

# İsteğe bağlı: özel alan adı kullanıyorsan canonical adres
# PUBLIC_HOST=ornek.com
