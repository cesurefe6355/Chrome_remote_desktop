{
  "name": "lumolive",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "test:db": "node test-db.js",
    "check:syntax": "node --check server.js && node --check db.js && node --check main.js && node --check preload.js",
    "desktop": "electron .",
    "desktop:local": "electron . --local",
    "build": "electron-builder"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^18.0.8",
    "express": "^4.18.2",
    "pg": "^8.23.1",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.lumolive.app",
    "productName": "LumoLive",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "bin/remote-input.exe"
    ],
    "extraResources": [
      {
        "from": "bin/remote-input.exe",
        "to": "bin/remote-input.exe"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "description": "LumoLive - Sesli sohbet ve canlı yayın",
  "author": "LumoLive",
  "engines": {
    "node": ">=18"
  }
}
